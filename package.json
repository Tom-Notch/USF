{
  "name": "project-page-template-astro",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "node --disable-warning=DEP0040 ./node_modules/astro/bin/astro.mjs dev",
    "start": "npm run dev --",
    "build": "npm run check && node --disable-warning=DEP0040 ./node_modules/astro/bin/astro.mjs build",
    "playwright:install": "playwright install chromium",
    "capture:og": "playwright install chromium && node scripts/capture-og-thumbnail.mjs",
    "build:deploy": "npm run build && playwright install chromium && node scripts/capture-og-thumbnail.mjs",
    "preview": "node --disable-warning=DEP0040 ./node_modules/astro/bin/astro.mjs preview",
    "astro": "node --disable-warning=DEP0040 ./node_modules/astro/bin/astro.mjs",
    "check": "node --disable-warning=DEP0040 ./node_modules/@astrojs/check/bin/astro-check.js",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier .",
    "format:fix": "prettier --write .",
    "all:fix": "npm run check && eslint --fix . && prettier --write .",
    "video:headline-posters": "ffmpeg -y -ss 27 -i public/HeadlineAnimationLight.mp4 -vframes 1 -c:v libwebp -quality 85 public/HeadlineAnimationLight-poster.webp && ffmpeg -y -ss 27 -i public/HeadlineAnimationDark.mp4 -vframes 1 -c:v libwebp -quality 85 public/HeadlineAnimationDark-poster.webp"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/mdx": "^5.0.6",
    "@astrojs/react": "^5.0.5",
    "@google/model-viewer": "^4.2.0",
    "@iconify-json/academicons": "^1.1.14",
    "@iconify-json/ri": "^1.2.3",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "astro": "^6.3.7",
    "astro-expressive-code": "^0.42.0",
    "astro-icon": "^1.1.0",
    "image-size": "^2.0.2",
    "pdf-to-img": "^6.1.0",
    "react": "^19.2.6",
    "react-compare-slider": "^4.0.0",
    "react-dom": "^19.2.6",
    "rehype-citation": "^2.3.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.0",
    "three": "^0.182.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.3"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.8.4",
    "@eslint/css": "^1.2.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.2.0",
    "@eslint/markdown": "^8.0.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.15",
    "eslint": "^10.4.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.6.0",
    "linkedom": "^0.18.12",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwind-csstree": "^0.3.2",
    "typescript-eslint": "^8.59.4"
  },
  "overrides": {
    "yaml": "2.8.3"
  }
}
