---
import type { Note } from "../types/types";

interface Props {
  notes: Note[];
}

const { notes } = Astro.props;
---

<div class="text-center text-base text-zinc-600 dark:text-zinc-400">
  {
    // prettier-ignore
    notes.map((note, index, array) =>
      <span>
        <sup>{note.symbol}</sup>
        {note.url ? (
          <a href={note.url} target="_blank" rel="noopener noreferrer">{note.text}</a>
        ) : (
          note.text
        )}
        {index < array.length - 1 ? ", " : ""}
      </span>
    )
  }
</div>
